{
  "name": "browser-device-check",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first browser-only device testing website for BrowserDeviceCheck.com.",
  "engines": {
    "node": ">=24.0.0 <27",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "predev": "node scripts/generate-static-files.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/validate-production-config.mjs && node scripts/generate-static-files.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "qa": "npm run test:architecture && npm run test:links && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run test:dist && npm run test:e2e",
    "test:architecture": "node scripts/audit-architecture.mjs",
    "test:dist": "node scripts/audit-dist.mjs",
    "test:links": "node scripts/audit-links.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.12.1",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@11.16.0"
}
