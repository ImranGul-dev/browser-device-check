---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/config/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImagePath?: string;
  ogImageAlt?: string;
  appendSiteName?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}
const { title, description, canonicalPath = Astro.url.pathname, noindex = false, ogType = 'website', jsonLd, ogImagePath = '/og/default.png', ogImageAlt, appendSiteName = true, publishedTime, modifiedTime } = Astro.props;
const resolvedOgImageAlt = ogImageAlt || `${title} on ${siteConfig.name}`;
const canonical = new URL(canonicalPath, siteConfig.origin).toString();
const fullTitle = !appendSiteName || title.includes(siteConfig.name) ? title : `${title} | ${siteConfig.name}`;
const ogImage = new URL(ogImagePath, siteConfig.origin).toString();
const serializedJsonLd = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
const siteEnvironment = import.meta.env.PUBLIC_SITE_ENV;
const isProduction = siteEnvironment ? siteEnvironment === 'production' : import.meta.env.PROD;
const robots = noindex ? 'noindex, follow' : isProduction ? 'index, follow, max-image-preview:large' : 'noindex, nofollow';
---
<!doctype html>
<html lang="en-US" data-consent-enabled={String(siteConfig.enableConsent)} data-ads-enabled={String(siteConfig.enableAds)} data-analytics-enabled={String(siteConfig.enableAnalytics)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#1D4ED8" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48x48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={serializedJsonLd}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>

