---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCard from '@/components/ToolCard.astro';
import { tests } from '@/config/site';
---
<BaseLayout title="Page Not Found" description="The requested page could not be found. Open a browser device test or return to the homepage." canonicalPath="/404.html" noindex>
  <section class="section content-container"><p class="eyebrow">Error 404</p><h1>Page not found</h1><p class="lead">The address may be incorrect, the page may have moved, or the link may be outdated. No test result was lost because the tools do not store account or cloud history.</p><div class="button-row"><a class="btn btn-primary" href="/">Return Home</a><a class="btn btn-secondary" href="/device-check/">Run Complete Device Check</a></div><h2>Popular device tests</h2><div class="card-grid">{tests.slice(0,6).map((test) => <ToolCard {...test} />)}</div></section>
</BaseLayout>
