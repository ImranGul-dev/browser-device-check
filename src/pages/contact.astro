---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PrivacyNotice from '@/components/PrivacyNotice.astro';
import RelatedLinks from '@/components/RelatedLinks.astro';
import { siteConfig } from '@/config/site';
import { buildSimplePageSchema } from '@/lib/schema';

const description = `Contact ${siteConfig.name} to report a test problem, technical correction, accessibility barrier, privacy question, or security concern.`;
const jsonLd = buildSimplePageSchema({
  type: 'ContactPage',
  name: `Contact ${siteConfig.name}`,
  path: '/contact/',
  description,
  includePublisher: false,
});
const thankYouUrl = new URL('/contact/thanks/', siteConfig.origin).toString();
---

<BaseLayout
  title={`Contact ${siteConfig.name}`}
  description={description}
  canonicalPath="/contact/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Contact' }]} />
  <section class="section-sm article-container prose">
    <h1>Contact {siteConfig.name}</h1>
    <p class="lead">
      Report a device-test problem, suggest a technical correction, share accessibility feedback,
      ask a privacy question, report a security concern, or suggest an improvement.
    </p>

    <h2>Before contacting us</h2>
    <p>
      For device troubleshooting, first open the relevant test or guide. The result may identify the
      exact permission, browser, or device issue.
    </p>
    <RelatedLinks
      links={[
        { title: 'Run Complete Device Check', href: '/device-check/' },
        { title: 'Test Your Webcam', href: '/webcam-test/' },
        { title: 'Test Your Microphone', href: '/microphone-test/' },
        {
          title: 'Fix Camera and Microphone Permissions',
          href: '/guides/camera-microphone-permissions/',
        },
        { title: 'Webcam Not Working', href: '/guides/webcam-not-working/' },
        { title: 'Microphone Not Working', href: '/guides/microphone-not-working/' },
      ]}
    />

    <h2>Send a message</h2>
    <p>
      Required fields are marked with <span aria-hidden="true">*</span>. Your submission is sent
      through FormSubmit to <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>.
    </p>

    <PrivacyNotice>
      <strong>Contact-form privacy:</strong> FormSubmit and its spam-protection services process the
      information you submit. FormSubmit states that submissions may be retained for 30 days. Do not
      include sensitive or confidential information.
    </PrivacyNotice>

    <form
      class="contact-form"
      action={siteConfig.formSubmitEndpoint}
      method="POST"
      accept-charset="UTF-8"
    >
      <input type="hidden" name="_subject" value={`New ${siteConfig.name} contact message`} />
      <input type="hidden" name="_next" value={thankYouUrl} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_url" value={`${siteConfig.origin}/contact/`} />
      <div class="form-honeypot" aria-hidden="true">
        <label for="contact-company">Leave this field empty</label>
        <input
          id="contact-company"
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="control-grid">
        <div class="field">
          <label for="contact-name">Name <span class="muted">(optional)</span></label>
          <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="120" />
        </div>
        <div class="field">
          <label for="contact-email">Email address <span aria-hidden="true">*</span></label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
            aria-describedby="contact-email-help"
          />
          <span id="contact-email-help" class="help-text">Used only to review and respond to your message.</span>
        </div>
      </div>

      <div class="control-grid">
        <div class="field">
          <label for="contact-topic">Topic <span aria-hidden="true">*</span></label>
          <select id="contact-topic" name="topic" required>
            <option value="">Choose a topic</option>
            <option>Device test problem</option>
            <option>Technical correction</option>
            <option>Accessibility feedback</option>
            <option>Privacy question or request</option>
            <option>Security concern</option>
            <option>Improvement suggestion</option>
            <option>Other</option>
          </select>
        </div>
        <div class="field">
          <label for="contact-page">Page address <span class="muted">(optional)</span></label>
          <input
            id="contact-page"
            name="page_url"
            type="url"
            inputmode="url"
            placeholder="https://browserdevicecheck.com/webcam-test/"
            maxlength="500"
          />
        </div>
      </div>

      <div class="field">
        <label for="contact-environment">Browser, operating system, and device <span class="muted">(optional)</span></label>
        <input
          id="contact-environment"
          name="browser_os_device"
          type="text"
          placeholder="Example: Chrome on Windows 11 laptop"
          maxlength="300"
        />
      </div>

      <div class="field">
        <label for="contact-message">What happened? <span aria-hidden="true">*</span></label>
        <textarea
          id="contact-message"
          name="message"
          rows="8"
          minlength="10"
          maxlength="5000"
          required
          aria-describedby="contact-message-help"
        ></textarea>
        <span id="contact-message-help" class="help-text">
          Include what you tried, what happened, what you expected, and any non-sensitive error message.
        </span>
      </div>

      <label class="checkbox-field" for="contact-acknowledgement">
        <input
          id="contact-acknowledgement"
          name="privacy_acknowledgement"
          type="checkbox"
          value="Accepted"
          required
        />
        <span>
          I understand that the information I submit will be processed to review and respond to my
          message, as explained in the Privacy Policy. <span aria-hidden="true">*</span>
        </span>
      </label>

      <button class="btn btn-primary" type="submit">Send Message</button>
    </form>

    <h2>What not to send</h2>
    <p>
      Do not send passwords, authentication codes, recovery phrases, payment-card information,
      government identification, medical records, financial statements, confidential workplace
      documents, recordings, private meeting links, or unnecessary information about another person.
    </p>

    <h2>Response and service limitations</h2>
    <p>
      We aim to review messages within {siteConfig.responseTime}. This is a target, not a guarantee.
      This contact page is not an emergency, medical, legal, financial, or safety service.
    </p>
    <p>
      Email fallback: <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>.
    </p>
  </section>
</BaseLayout>
